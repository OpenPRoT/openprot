load("@pigweed//pw_kernel/tooling:system_image.bzl", "system_image")
load("@pigweed//pw_kernel/tooling:target_codegen.bzl", "target_codegen")
load("@pigweed//pw_kernel/tooling:target_linker_script.bzl", "target_linker_script")
load("@rules_rust//rust:defs.bzl", "rust_binary")
load("//target/ast10x0:defs.bzl", "TARGET_COMPATIBLE_WITH", "system_image_test")

# Both roles are kernel-only with the same memory layout, so one config, one
# codegen and one linker script serve both binaries.
filegroup(
    name = "system_config",
    srcs = ["system.json5"],
)

target_codegen(
    name = "codegen",
    arch = "@pigweed//pw_kernel/arch/arm_cortex_m:arch_arm_cortex_m",
    system_config = ":system_config",
    target_compatible_with = TARGET_COMPATIBLE_WITH,
)

target_linker_script(
    name = "linker_script",
    system_config = ":system_config",
    tags = ["kernel"],
    target_compatible_with = TARGET_COMPATIBLE_WITH,
    template = "//target/ast10x0:linker_script_template",
)

rust_binary(
    name = "target_rot",
    srcs = [
        "shared.rs",
        "target_rot.rs",
    ],
    edition = "2024",
    tags = ["kernel"],
    target_compatible_with = TARGET_COMPATIBLE_WITH,
    deps = [
        ":codegen",
        ":linker_script",
        "//target/ast10x0:entry",
        "//target/ast10x0/board:ast10x0_board",
        "//target/ast10x0/peripherals",
        "@pigweed//pw_kernel/arch/arm_cortex_m:arch_arm_cortex_m",
        "@pigweed//pw_kernel/kernel",
        "@pigweed//pw_kernel/subsys/console:console_backend",
        "@pigweed//pw_kernel/target:target_common",
        "@pigweed//pw_log/rust:pw_log",
    ],
)

rust_binary(
    name = "target_bmc",
    srcs = [
        "shared.rs",
        "target_bmc.rs",
    ],
    edition = "2024",
    tags = ["kernel"],
    target_compatible_with = TARGET_COMPATIBLE_WITH,
    deps = [
        ":codegen",
        ":linker_script",
        "//target/ast10x0:entry",
        "//target/ast10x0/board:ast10x0_board",
        "//target/ast10x0/peripherals",
        "@pigweed//pw_kernel/arch/arm_cortex_m:arch_arm_cortex_m",
        "@pigweed//pw_kernel/kernel",
        "@pigweed//pw_kernel/subsys/console:console_backend",
        "@pigweed//pw_kernel/target:target_common",
        "@pigweed//pw_log/rust:pw_log",
    ],
)

system_image(
    name = "rot_image",
    kernel = ":target_rot",
    platform = "//target/ast10x0",
    system_config = ":system_config",
    tags = ["kernel"],
    target_compatible_with = TARGET_COMPATIBLE_WITH,
    userspace = False,
    visibility = ["//visibility:public"],
)

system_image(
    name = "bmc_image",
    kernel = ":target_bmc",
    platform = "//target/ast10x0",
    system_config = ":system_config",
    tags = ["kernel"],
    target_compatible_with = TARGET_COMPATIBLE_WITH,
    userspace = False,
    visibility = ["//visibility:public"],
)

# `image` goes to device A, which the harness flashes first: the RoT has to own
# the flash before the reader boots and starts polling.
system_image_test(
    name = "shared_flash_test",
    timeout = "eternal",
    image = ":rot_image",
    slave_image = ":bmc_image",
    tags = [
        "hardware",
        "manual",
    ],
    target_compatible_with = select({
        "//target/ast10x0:qemu_enabled": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)
