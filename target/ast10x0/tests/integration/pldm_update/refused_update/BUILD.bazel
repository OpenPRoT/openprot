# The update scenario's negative case: the RoT refuses the request.
#
# It passes when the orchestrator agrees to nothing and the update does
# not go through, which is what says the gate is a gate rather than a
# report.

load("//target/ast10x0/tests/integration:scenario.bzl", "qemu_scenario")
load("//target/ast10x0/tests/integration/pldm_update:apps.bzl", "APPS", "SYSTEM_CONFIG", "TARGET_SRC")

# bazel test --config=virt_ast10x0 //target/ast10x0/tests/integration/pldm_update/refused_update:refused_update_qemu_test
qemu_scenario(
    name = "refused_update_qemu",
    apps = APPS,
    cfgs = ["refused_update"],
    system_config = SYSTEM_CONFIG,
    target_src = TARGET_SRC,
)
