# The update scenario's negative case: the agent sends one wrong byte.
#
# It passes when the device catches that byte and the update does not go
# through. Failing for any other reason fails the test, so a green here
# says the content check is what stopped it.

load("//target/ast10x0/tests/integration:scenario.bzl", "qemu_scenario")
load("//target/ast10x0/tests/integration/pldm_update:apps.bzl", "APPS", "FLASH", "SYSTEM_CONFIG", "TARGET_DEPS", "TARGET_SRC")

# bazel test --config=virt_ast10x0 //target/ast10x0/tests/integration/pldm_update/corrupt_image:corrupt_image_qemu_test
qemu_scenario(
    name = "corrupt_image_qemu",
    apps = APPS,
    cfgs = ["corrupt_image"],
    flash = FLASH,
    system_config = SYSTEM_CONFIG,
    target_deps = TARGET_DEPS,
    target_src = TARGET_SRC,
)
