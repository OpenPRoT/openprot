# The boot scenario's negative case: the device never reports ready.
#
# Same sources, same system config, one flag. It passes when the walk
# times out, the checkpoint is named and the platform locks, so a green
# here is what says the boot scenario's green means something.

load("//target/ast10x0/tests/integration:scenario.bzl", "qemu_scenario")
load("//target/ast10x0/tests/integration/mock_bmc:apps.bzl", "APPS", "SYSTEM_CONFIG", "TARGET_SRC")

# bazel test --config=virt_ast10x0 //target/ast10x0/tests/integration/mock_bmc/device_hangs:device_hangs_qemu_test
qemu_scenario(
    name = "device_hangs_qemu",
    apps = APPS,
    cfgs = ["device_hangs"],
    system_config = SYSTEM_CONFIG,
    target_src = TARGET_SRC,
)
