# The boot scenario with the eRoT running the trial image of its own
# update.
#
# Same sources, same system config, one flag. The session starts at
# TrialPending, as the boot after an activation would find it, and the
# chain coming up moves it to Committed. The run then dispatches the
# request for the SVN floor advance the Update Agent would send as
# UpdateSecurityRevision, and passes when the anti-rollback floor reads the
# SVN the trial recorded and the session has closed.

load("//target/ast10x0/tests/integration:scenario.bzl", "qemu_scenario")
load("//target/ast10x0/tests/integration/mock_downstream_device:apps.bzl", "APPS", "SYSTEM_CONFIG", "TARGET_SRC")

# bazel test --config=virt_ast10x0 //target/ast10x0/tests/integration/mock_downstream_device/self_trial:self_trial_qemu_test
qemu_scenario(
    name = "self_trial_qemu",
    apps = APPS,
    cfgs = ["self_trial"],
    system_config = SYSTEM_CONFIG,
    target_src = TARGET_SRC,
)
