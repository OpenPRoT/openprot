load("@pigweed//pw_kernel/tooling:rust_app.bzl", "rust_app")
load("@pigweed//pw_kernel/tooling:system_image.bzl", "system_image", "system_image_test")
load("@pigweed//pw_kernel/tooling:target_codegen.bzl", "target_codegen")
load("@pigweed//pw_kernel/tooling:target_linker_script.bzl", "target_linker_script")
load("@pigweed//pw_kernel/tooling/panic_detector:rust_binary_no_panics_test.bzl", "rust_binary_no_panics_test")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library")
load("//target/ast10x0:defs.bzl", "TARGET_COMPATIBLE_WITH")

# ── System configuration ───────────────────────────────────────────────────────

filegroup(
    name = "system_config",
    srcs = ["system.json5"],
)

# ── Kernel image ───────────────────────────────────────────────────────────────

target_codegen(
    name = "codegen",
    arch = "@pigweed//pw_kernel/arch/arm_cortex_m:arch_arm_cortex_m",
    system_config = ":system_config",
    target_compatible_with = TARGET_COMPATIBLE_WITH,
)

target_linker_script(
    name = "linker_script",
    system_config = ":system_config",
    tags = ["kernel"],
    target_compatible_with = TARGET_COMPATIBLE_WITH,
    template = "//target/ast10x0:linker_script_template",
)

rust_binary(
    name = "target",
    srcs = ["target.rs"],
    edition = "2024",
    tags = ["kernel"],
    target_compatible_with = TARGET_COMPATIBLE_WITH,
    deps = [
        ":codegen",
        ":linker_script",
        "//target/ast10x0:entry",
        "@pigweed//pw_kernel/arch/arm_cortex_m:arch_arm_cortex_m",
        "@pigweed//pw_kernel/kernel",
        "@pigweed//pw_kernel/subsys/console:console_backend",
        "@pigweed//pw_kernel/target:target_common",
        "@pigweed//pw_kernel/userspace",
        "@pigweed//pw_log/rust:pw_log",
    ],
)

# ── MCTP server (the messaging layer under test) ───────────────────────────────

rust_app(
    name = "mctp_server",
    srcs = ["server_main.rs"],
    codegen_crate_name = "app_mctp_server",
    edition = "2024",
    system_config = ":system_config",
    tags = ["kernel"],
    target_compatible_with = TARGET_COMPATIBLE_WITH,
    deps = [
        "//services/mctp/api:mctp_api",
        "//services/mctp/server:mctp_server_lib",
        "//services/mctp/server-runtime:mctp_server_runtime",
        "@pigweed//pw_kernel/userspace",
        "@pigweed//pw_log/rust:pw_log",
        "@pigweed//pw_status/rust:pw_status",
        "@rust_crates//:heapless",
        "@rust_crates//:mctp",
        "@rust_crates//:mctp-lib",
    ],
)

# ── Echo tasks standing in for application protocols ────────────────────────────────────────────────────────
# One shared body (echo_task.rs); each app only picks its message type.
# Swap either app for a real protocol task without
# touching the server or the system topology.

rust_library(
    name = "echo_task",
    srcs = ["echo_task.rs"],
    edition = "2024",
    tags = ["kernel"],
    target_compatible_with = TARGET_COMPATIBLE_WITH,
    deps = [
        "//services/mctp/api:mctp_api",
        "//services/mctp/client-ipc:mctp_client_ipc",
        "@pigweed//pw_kernel/userspace",
        "@pigweed//pw_log/rust:pw_log",
        "@pigweed//pw_status/rust:pw_status",
        "@rust_crates//:mctp-lib",
    ],
)

rust_app(
    name = "spdm_echo",
    srcs = ["spdm_echo_main.rs"],
    codegen_crate_name = "app_spdm_echo",
    edition = "2024",
    system_config = ":system_config",
    tags = ["kernel"],
    target_compatible_with = TARGET_COMPATIBLE_WITH,
    deps = [
        ":echo_task",
        "@pigweed//pw_kernel/userspace",
    ],
)

rust_app(
    name = "pldm_echo",
    srcs = ["pldm_echo_main.rs"],
    codegen_crate_name = "app_pldm_echo",
    edition = "2024",
    system_config = ":system_config",
    tags = ["kernel"],
    target_compatible_with = TARGET_COMPATIBLE_WITH,
    deps = [
        ":echo_task",
        "@pigweed//pw_kernel/userspace",
    ],
)

# ── Harness ────────────────────────────────────────────────────────────────────
# Plays the remote peer for both echo tasks and calls debug_shutdown(Ok|Err).

rust_app(
    name = "harness",
    srcs = ["harness_main.rs"],
    codegen_crate_name = "app_harness",
    edition = "2024",
    system_config = ":system_config",
    tags = ["kernel"],
    target_compatible_with = TARGET_COMPATIBLE_WITH,
    deps = [
        ":echo_task",
        "//services/mctp/api:mctp_api",
        "//services/mctp/client-ipc:mctp_client_ipc",
        "@pigweed//pw_kernel/userspace",
        "@pigweed//pw_log/rust:pw_log",
        "@pigweed//pw_status/rust:pw_status",
        "@rust_crates//:mctp-lib",
    ],
)

# ── System image ───────────────────────────────────────────────────────────────

system_image(
    name = "multi_protocol_image",
    apps = [
        ":mctp_server",
        ":spdm_echo",
        ":pldm_echo",
        ":harness",
    ],
    kernel = ":target",
    platform = "//target/ast10x0",
    system_config = ":system_config",
    tags = ["kernel"],
    target_compatible_with = TARGET_COMPATIBLE_WITH,
    visibility = ["//visibility:public"],
)

# ── Test target ────────────────────────────────────────────────────────────────
# Run with: bazel test --config=virt_ast10x0 //target/ast10x0/tests/mctp/multi_protocol:multi_protocol_qemu_test

system_image_test(
    name = "multi_protocol_qemu_test",
    image = ":multi_protocol_image",
    tags = ["qemu_only"],
    target_compatible_with = TARGET_COMPATIBLE_WITH,
)

rust_binary_no_panics_test(
    name = "no_panics_test",
    binary = ":multi_protocol_image",
    tags = ["kernel"],
)
