// AST10x0 MCTP control responder QEMU configuration.
//
// Two-app layout. QEMU offers no I2C peer, so the fake server stands in for
// both the MCTP server and the bus owner behind it:
//
//   fake_server        - answers the responder's IPC calls and scripts the test
//   mctp_control_qemu  - the responder under test
//
// Memory map (AST10x0: 768 KB SRAM, no XIP):
//   0x00000000 - 0x00000500  vector table (1280 B)
//   0x00000500 - 0x00020000  kernel flash (~127 KB)
//   0x00020000 - 0x00060000  app flash (256 KB total; 128 KB per app)
//   0x00060000 - 0x00080000  kernel RAM (128 KB)
//   0x00080000 - 0x00098000  app RAM (96 KB total: 64 KB fake_server,
//                            32 KB responder)
{
    arch: {
        type: "armv7m",
        vector_table_start_address: 0x00000000,
        vector_table_size_bytes: 1280,
    },
    kernel: {
        flash_start_address: 0x00000500,
        flash_size_bytes: 129792,
        ram_start_address: 0x00060000,
        ram_size_bytes: 131072,
    },
    apps: [
        {
            name: "fake_server",
            flash_size_bytes: 131072,
            processes: [
                {
                    name: "fake_server_process",
                    ram_size_bytes: 65536,
                    objects: [
                        {
                            name: "wg",
                            type: "wait_group",
                        },
                        {
                            name: "mctp",
                            type: "channel_handler",
                        },
                        {
                            type: "thread",
                            name: "fake_server_thread",
                            kernel_stack_size_bytes: 4096,
                        },
                    ],
                },
            ],
        },
        {
            name: "mctp_control_qemu",
            flash_size_bytes: 131072,
            processes: [
                {
                    name: "mctp_control_process",
                    ram_size_bytes: 32768,
                    objects: [
                        {
                            name: "mctp",
                            type: "channel_initiator",
                            handler_process: "fake_server_process",
                            handler_object_name: "mctp",
                        },
                        {
                            type: "thread",
                            name: "mctp_control_thread",
                            kernel_stack_size_bytes: 4096,
                        },
                    ],
                },
            ],
        },
    ],
}
