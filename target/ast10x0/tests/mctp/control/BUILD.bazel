load("@pigweed//pw_kernel/tooling:rust_app.bzl", "rust_app")
load("@pigweed//pw_kernel/tooling:system_image.bzl", "system_image")
load("@pigweed//pw_kernel/tooling:target_codegen.bzl", "target_codegen")
load("@pigweed//pw_kernel/tooling:target_linker_script.bzl", "target_linker_script")
load("@pigweed//pw_kernel/tooling/panic_detector:rust_binary_no_panics_test.bzl", "rust_binary_no_panics_test")
load("@rules_rust//rust:defs.bzl", "rust_binary")
load("//target/ast10x0:defs.bzl", "TARGET_COMPATIBLE_WITH", "system_image_test")

# ── System configurations ─────────────────────────────────────────────────────

filegroup(
    name = "system_config",
    srcs = ["system.json5"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "qemu_system_config",
    srcs = ["qemu_system.json5"],
    visibility = ["//visibility:public"],
)

# ── Hardware image: I2C server, MCTP server, control responder ────────────────
# Needs a real bus owner, so it runs on the fixture rather than under QEMU.

target_codegen(
    name = "codegen",
    arch = "@pigweed//pw_kernel/arch/arm_cortex_m:arch_arm_cortex_m",
    system_config = ":system_config",
    target_compatible_with = TARGET_COMPATIBLE_WITH,
)

target_linker_script(
    name = "linker_script",
    system_config = ":system_config",
    tags = ["kernel"],
    target_compatible_with = TARGET_COMPATIBLE_WITH,
    template = "//target/ast10x0:linker_script_template",
)

rust_binary(
    name = "target",
    srcs = ["target.rs"],
    edition = "2024",
    tags = ["kernel"],
    target_compatible_with = TARGET_COMPATIBLE_WITH,
    deps = [
        ":codegen",
        ":linker_script",
        "//target/ast10x0:entry",
        "//target/ast10x0/board:ast10x0_board",
        "//target/ast10x0/peripherals",
        "@ast1060_pac",
        "@pigweed//pw_kernel/arch/arm_cortex_m:arch_arm_cortex_m",
        "@pigweed//pw_kernel/kernel",
        "@pigweed//pw_kernel/subsys/console:console_backend",
        "@pigweed//pw_kernel/target:target_common",
        "@pigweed//pw_kernel/userspace",
    ],
)

# The I2C server and MCTP server apps are copies of tests/mctp/server's, as in
# spdm/auth and spdm/vca: each image fixes its own bus number and I2C addresses
# in its own source.

rust_app(
    name = "i2c_server",
    srcs = ["i2c_server_main.rs"],
    codegen_crate_name = "app_i2c_server",
    edition = "2024",
    system_config = ":system_config",
    tags = ["kernel"],
    target_compatible_with = TARGET_COMPATIBLE_WITH,
    deps = [
        "//services/i2c/server-runtime:i2c_server_runtime",
        "//target/ast10x0/backend/i2c:i2c_backend_ast10x0",
        "//target/ast10x0/peripherals",
        "@pigweed//pw_kernel/userspace",
        "@pigweed//pw_log/rust:pw_log",
    ],
)

rust_app(
    name = "mctp_server",
    srcs = ["mctp_server_main.rs"],
    codegen_crate_name = "app_mctp_server",
    edition = "2024",
    system_config = ":system_config",
    tags = ["kernel"],
    target_compatible_with = TARGET_COMPATIBLE_WITH,
    deps = [
        "//services/i2c/api:i2c_api",
        "//services/i2c/client:i2c_client",
        "//services/i2c/client-ipc:i2c_client_ipc",
        "//services/mctp/api:mctp_api",
        "//services/mctp/server:mctp_server_lib",
        "//services/mctp/server-runtime:mctp_server_runtime",
        "//services/mctp/transport-i2c:mctp_transport_i2c",
        "@pigweed//pw_kernel/syscall:syscall_user",
        "@pigweed//pw_kernel/userspace",
        "@pigweed//pw_log/rust:pw_log",
        "@pigweed//pw_status/rust:pw_status",
        "@rust_crates//:mctp",
        "@rust_crates//:mctp-lib",
    ],
)

rust_app(
    name = "mctp_control",
    srcs = ["control_main.rs"],
    codegen_crate_name = "app_mctp_control",
    edition = "2024",
    system_config = ":system_config",
    tags = ["kernel"],
    target_compatible_with = TARGET_COMPATIBLE_WITH,
    deps = [
        "//services/mctp/api:mctp_api",
        "//services/mctp/client-ipc:mctp_client_ipc",
        "//services/mctp/control:mctp_control",
        "@pigweed//pw_kernel/userspace",
        "@pigweed//pw_log/rust:pw_log",
        "@rust_crates//:mctp-lib",
    ],
)

system_image(
    name = "mctp_control_image",
    apps = [
        ":i2c_server",
        ":mctp_server",
        ":mctp_control",
    ],
    kernel = ":target",
    platform = "//target/ast10x0",
    system_config = ":system_config",
    tags = ["kernel"],
    target_compatible_with = TARGET_COMPATIBLE_WITH,
    visibility = ["//visibility:public"],
)

# Exchanges real traffic with a BMC on the hardware fixture. No app calls
# debug_shutdown, so the run prints no TEST_RESULT and ends at the timeout;
# the UART log and the BMC side give the result.
# Run with: bazel test --config=k_ast1060_evb //target/ast10x0/tests/mctp/control:mctp_control_test

system_image_test(
    name = "mctp_control_test",
    timeout = "eternal",
    image = ":mctp_control_image",
    tags = [
        "hardware",
        "manual",
    ],
    target_compatible_with = select({
        "//target/ast10x0:qemu_enabled": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)

# ── QEMU image: fake bus owner and the control responder ──────────────────────
# QEMU offers no I2C peer, so the fake server takes the place of both the MCTP
# server and the bus owner behind it.

target_codegen(
    name = "qemu_codegen",
    arch = "@pigweed//pw_kernel/arch/arm_cortex_m:arch_arm_cortex_m",
    # The kernel source names this crate `codegen`, as every other image does,
    # so the crate name stays fixed while the target name distinguishes the two
    # configurations in this one package.
    crate_name = "codegen",
    system_config = ":qemu_system_config",
    target_compatible_with = TARGET_COMPATIBLE_WITH,
)

target_linker_script(
    name = "qemu_linker_script",
    system_config = ":qemu_system_config",
    tags = ["kernel"],
    target_compatible_with = TARGET_COMPATIBLE_WITH,
    template = "//target/ast10x0:linker_script_template",
)

rust_binary(
    name = "qemu_target",
    srcs = ["qemu_target.rs"],
    crate_root = "qemu_target.rs",
    edition = "2024",
    tags = ["kernel"],
    target_compatible_with = TARGET_COMPATIBLE_WITH,
    deps = [
        ":qemu_codegen",
        ":qemu_linker_script",
        "//target/ast10x0:entry",
        "@pigweed//pw_kernel/arch/arm_cortex_m:arch_arm_cortex_m",
        "@pigweed//pw_kernel/kernel",
        "@pigweed//pw_kernel/subsys/console:console_backend",
        "@pigweed//pw_kernel/target:target_common",
        "@pigweed//pw_kernel/userspace",
        "@pigweed//pw_log/rust:pw_log",
    ],
)

rust_app(
    name = "fake_server",
    srcs = ["fake_server_main.rs"],
    codegen_crate_name = "app_fake_server",
    edition = "2024",
    system_config = ":qemu_system_config",
    tags = ["kernel"],
    target_compatible_with = TARGET_COMPATIBLE_WITH,
    deps = [
        "//services/mctp/api:mctp_api",
        "@pigweed//pw_kernel/userspace",
        "@pigweed//pw_log/rust:pw_log",
        "@pigweed//pw_status/rust:pw_status",
        "@rust_crates//:mctp-lib",
    ],
)

rust_app(
    name = "mctp_control_qemu",
    srcs = ["control_main_qemu.rs"],
    codegen_crate_name = "app_mctp_control_qemu",
    edition = "2024",
    system_config = ":qemu_system_config",
    tags = ["kernel"],
    target_compatible_with = TARGET_COMPATIBLE_WITH,
    deps = [
        "//services/mctp/api:mctp_api",
        "//services/mctp/client-ipc:mctp_client_ipc",
        "//services/mctp/control:mctp_control",
        "@pigweed//pw_kernel/userspace",
        "@pigweed//pw_log/rust:pw_log",
        "@rust_crates//:mctp-lib",
    ],
)

system_image(
    name = "mctp_control_qemu_image",
    apps = [
        ":fake_server",
        ":mctp_control_qemu",
    ],
    kernel = ":qemu_target",
    platform = "//target/ast10x0",
    system_config = ":qemu_system_config",
    tags = ["kernel"],
    target_compatible_with = TARGET_COMPATIBLE_WITH,
    visibility = ["//visibility:public"],
)

# Run with: bazel test --config=virt_ast10x0 //target/ast10x0/tests/mctp/control:mctp_control_qemu_test

system_image_test(
    name = "mctp_control_qemu_test",
    image = ":mctp_control_qemu_image",
    tags = ["qemu_only"],
    target_compatible_with = TARGET_COMPATIBLE_WITH,
)

rust_binary_no_panics_test(
    name = "qemu_no_panics_test",
    binary = ":mctp_control_qemu_image",
    tags = ["kernel"],
)
