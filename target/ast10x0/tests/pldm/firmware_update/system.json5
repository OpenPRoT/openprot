// AST10x0 PLDM firmware-update test, RoT side (card A, the Firmware Device).
//
// Multi-app configuration:
// - i2c_server: owns i2c hardware and runs i2c_server_runtime
// - mctp_server: uses i2c transport over IPC + serves MCTP control channel
// - pldm_fd: runs the PLDM Firmware Device against the update agent on card B
{
    arch: {
        type: "armv7m",
        vector_table_start_address: 0x00000000,
        vector_table_size_bytes: 1792,
    },
    kernel: {
        flash_start_address: 0x00000700,
        flash_size_bytes: 129280,
        ram_start_address: 0x00060000,
        ram_size_bytes: 131072,
    },
    apps: [
        {
            name: "i2c_server",
            flash_size_bytes: 65536,
            processes: [
                {
                    name: "i2c_server_process",
                    ram_size_bytes: 65536,
                    objects: [
                        {
                            name: "wg",
                            type: "wait_group",
                        },
                        {
                            name: "i2c",
                            type: "channel_handler",
                        },
                        {
                            name: "i2c2_irq",
                            type: "interrupt",
                            irqs: [
                                {
                                    name: "i2c2",
                                    number: 112,
                                },
                            ],
                        },
                        {
                            type: "thread",
                            name: "i2c_server_thread",
                            kernel_stack_size_bytes: 4096,
                        },
                    ],
                    memory_mappings: [
                        {
                            name: "i2c_regs",
                            type: "device",
                            start_address: 0x7e7b0000,
                            size_bytes: 0x4000,
                        },
                    ],
                },
            ],
        },
        {
            name: "mctp_server",
            flash_size_bytes: 131072,
            processes: [
                {
                    name: "mctp_server_process",
                    ram_size_bytes: 65536,
                    objects: [
                        {
                            name: "wg",
                            type: "wait_group",
                        },
                        {
                            name: "mctp",
                            type: "channel_handler",
                        },
                        {
                            name: "i2c",
                            type: "channel_initiator",
                            handler_process: "i2c_server_process",
                            handler_object_name: "i2c",
                        },
                        {
                            type: "thread",
                            name: "mctp_server_thread",
                            kernel_stack_size_bytes: 4096,
                        },
                    ],
                },
            ],
        },
        {
            name: "pldm_fd",
            flash_size_bytes: 65536,
            processes: [
                {
                    name: "pldm_fd_process",
                    ram_size_bytes: 65536,
                    objects: [
                        {
                            name: "mctp",
                            type: "channel_initiator",
                            handler_process: "mctp_server_process",
                            handler_object_name: "mctp",
                        },
                        {
                            type: "thread",
                            name: "pldm_fd_thread",
                            kernel_stack_size_bytes: 4096,
                        },
                    ],
                    memory_mappings: [
                        // FMC pinctrl is applied by the kernel target's
                        // pre-task init, so this app does not map the SCU.
                        {
                            // FMC controller registers.
                            name: "fmc_regs",
                            type: "device",
                            start_address: 0x7e620000,
                            size_bytes: 0x1000,
                        },
                        {
                            // FMC CS0 boot flash, 1 MiB on the AST1060. Mapped
                            // because init resolves geometry and runs timing
                            // calibration against every configured chip select,
                            // not just the one this app uses.
                            name: "fmc_cs0_window",
                            type: "device",
                            start_address: 0x80000000,
                            size_bytes: 0x100000,
                        },
                        {
                            // FMC CS1 memory-mapped flash read window (64 MiB);
                            // the image lands here.
                            name: "fmc_cs1_window",
                            type: "device",
                            start_address: 0x88000000,
                            size_bytes: 0x04000000,
                        },
                    ],
                },
            ],
        },
    ],
}
