# executor cancels it and reports a failed verification, the verifier's late
# reply is dropped, and the re-walk ends in Ready.
#
# bazel test --config=virt_ast10x0 //target/ast10x0/tests/orchestrator/async_sim/verify_hangs:verify_hangs_qemu_test

load("//target/ast10x0/tests/orchestrator/async_sim:apps.bzl", "APPS", "SYSTEM_CONFIG", "TARGET_SRC")
load("//target/ast10x0/tests/orchestrator/async_sim:scenario.bzl", "qemu_scenario")

qemu_scenario(
    name = "verify_hangs_qemu",
    apps = APPS,
    cfgs = ["verify_hangs"],
    system_config = SYSTEM_CONFIG,
    target_src = TARGET_SRC,
)
