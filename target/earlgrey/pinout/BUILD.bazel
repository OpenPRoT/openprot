        "config.rs",
        "dualsbs.rs",
        "lib.rs",
        "swstraps.rs",
        "target.rs",
    ],
    crate_name = "earlgrey_pinout",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "//hal/blocking",
        "//target/earlgrey/drivers:gpio",
        "//target/earlgrey/drivers:pinmux",
        "//target/earlgrey/registers:top_earlgrey",
