load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@bazel_skylib//rules:native_binary.bzl", "native_binary")

# Symlink the external @caliptra_fpga_bitstream PDI into this package so it
# lands at _main/target/veer/tooling/fpga/ in FPGA tests' runfiles, next to
# run_on_board.sh.
copy_file(
    name = "bitstream_pdi",
    src = "@caliptra_fpga_bitstream//file",
    out = "caliptra-bitstream.pdi",
    allow_symlink = True,
    tags = ["fpga"],
    target_compatible_with = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
)

# Board-side files that run_remote expects in every FPGA test's runfiles
# (added as `data` by `caliptra_test`).
filegroup(
    name = "board_files",
    srcs = [
        "run_on_board.sh",
        ":bitstream_pdi",
    ],
    tags = ["fpga"],
    target_compatible_with = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
    visibility = ["//target/veer:__subpackages__"],
)

# `--run_under` wrapper for `bazel test --config=fpga`.
native_binary(
    name = "run_remote",
    src = "run_remote.sh",
    out = "run_remote",
    visibility = ["//visibility:public"],
)
