// VeeR on-target test for MCTP over I3C (//services/mctp/transport-i3c).
//
// One app, three processes, mirroring the ast10x0 tests/mctp/server topology
// but over I3C instead of I2C (and packed into a single multi_process_app, as
// tests/i3c_service does):
//
//   i3c_server  -- owns the I3C peripheral and PIC IRQ 2, runs the
//                  i3c_server_runtime reactor (as in tests/i3c_service). On an
//                  inbound frame it latches the payload and raises USER on the
//                  mctp_server's channel.
//   mctp_server -- an i3c client (initiator "i3c" -> i3c_server "channel") that
//                  runs the MCTP router over I3cSender/MctpI3cReceiver and
//                  serves MCTP app clients on channel handler "mctp".
//   mctp_echo   -- an MCTP app client (initiator "mctp" -> mctp_server "mctp")
//                  that echoes one request back, then exits 0.
//
// Addresses are rendered per platform (emulator or FPGA) from upstream
// caliptra-mcu-sw's memory maps by `veer_system_config`:
//   @KERNEL_FLASH_START@  MCU SRAM start (code + data execute here)
//   @KERNEL_RAM_START@    app data, 0x40000 into MCU SRAM
//   @I3C_BASE@            I3C register block (device-mapped into i3c_server)
{
  arch: {
    type: "riscv",
  },
  kernel: {
    flash_start_address: @KERNEL_FLASH_START@,
    flash_size_bytes: 0x10000,
    ram_start_address: @KERNEL_RAM_START@,
    ram_size_bytes: 0x8000,
  },
  apps: [
    {
      name: "mctp_i3c",
      flash_size_bytes: 0x30000,
      processes: [
        {
          name: "i3c_server",
          ram_size_bytes: 0x4000,
          objects: [
            { name: "wg", type: "wait_group" },
            {
              name: "i3c_irq",
              type: "interrupt",
              irqs: [{ name: "i3c", number: 2 }],
            },
            { name: "channel", type: "channel_handler" },
            {
              type: "thread",
              name: "i3c_server_thread",
              kernel_stack_size_bytes: 2048,
            },
          ],
          memory_mappings: [
            {
              name: "i3c_regs",
              type: "device",
              start_address: @I3C_BASE@,
              size_bytes: 0x1000,
            },
          ],
        },
        {
          name: "mctp_server",
          ram_size_bytes: 0x10000,
          objects: [
            { name: "wg", type: "wait_group" },
            { name: "mctp", type: "channel_handler" },
            {
              name: "i3c",
              type: "channel_initiator",
              handler_process: "i3c_server",
              handler_object_name: "channel",
            },
            {
              type: "thread",
              name: "mctp_server_thread",
              kernel_stack_size_bytes: 4096,
            },
          ],
        },
        {
          name: "mctp_echo",
          ram_size_bytes: 0x4000,
          objects: [
            {
              name: "mctp",
              type: "channel_initiator",
              handler_process: "mctp_server",
              handler_object_name: "mctp",
            },
            {
              type: "thread",
              name: "mctp_echo_thread",
              kernel_stack_size_bytes: 2048,
            },
          ],
        },
      ],
    },
  ],
}
