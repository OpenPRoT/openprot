load("@pigweed//pw_kernel/tooling:target_codegen.bzl", "target_codegen")
load("@pigweed//pw_kernel/tooling:target_linker_script.bzl", "target_linker_script")
load("@pigweed//pw_kernel/tooling/panic_detector:rust_binary_no_panics_test.bzl", "rust_binary_no_panics_test")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library")
load("//target/veer:defs.bzl", "TARGET_COMPATIBLE_WITH", "veer_system_config", "veer_system_image")
load("//target/veer/tooling:caliptra_runner.bzl", "caliptra_test")

veer_system_image(
    name = "ocp_recovery",
    kernel = ":target",
    platform = "//target/veer",
)

target_linker_script(
    name = "linker_script",
    system_config = ":system_config",
    tags = ["kernel"],
    template = "//target/veer:linker_script_template",
)

rust_binary_no_panics_test(
    name = "no_panics_test",
    binary = ":ocp_recovery",
)

veer_system_config(
    name = "system_config",
    src = "system.json5.tmpl",
)

target_codegen(
    name = "codegen",
    arch = "@pigweed//pw_kernel/arch/riscv:arch_riscv",
    system_config = ":system_config",
)

# The test image, shared by the firmware and the host test.
rust_library(
    name = "image",
    srcs = ["image.rs"],
    edition = "2024",
)

rust_binary(
    name = "target",
    srcs = ["target.rs"],
    edition = "2024",
    target_compatible_with = TARGET_COMPATIBLE_WITH,
    deps = [
        ":codegen",
        ":image",
        ":linker_script",
        "//hal/blocking/ocp_recovery",
        "//target/veer:config",
        "//target/veer:entry",
        "//target/veer/peripherals/ocp_recovery",
        "//util/error",
        "//util/types",
        "@pigweed//pw_kernel/arch/riscv:arch_riscv",
        "@pigweed//pw_kernel/kernel",
        "@pigweed//pw_kernel/subsys/console:console_backend",
        "@pigweed//pw_kernel/target:target_common",
        "@pigweed//pw_log/rust:pw_log",
    ],
)

caliptra_test(
    name = "ocp_recovery_test",
    srcs = [
        "emulator_agent.rs",
        "fpga_agent.rs",
        "ocp_recovery_host_test.rs",
    ],
    crate_root = "ocp_recovery_host_test.rs",
    mcu_image = ":ocp_recovery",
    deps = [
        ":image",
        "//target/veer/peripherals/ocp_recovery",
        "//target/veer/registers",
        "@rust_caliptra_crates//:caliptra-ureg",
    ],
)
