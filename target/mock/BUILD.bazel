load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "devices",
    srcs = ["devices.rs"],
    crate_name = "board_devices",
    edition = "2024",
    deps = ["//services/orchestrator/config:orchestrator_config"],
)

# Host test: the table this board declares is everything the orchestrator
# needs — table → chain → orchestrator, end to end.
rust_test(
    name = "devices_test",
    crate = ":devices",
    deps = ["//services/orchestrator/sm:orchestrator_sm"],
)
