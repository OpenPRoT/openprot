load("@rules_rust//rust:defs.bzl", "rust_library")

# Kernel side of a u64 millisecond deadline. Not the clock for every service:
# a loop that already waits on an Instant should keep that deadline. Kernel
# only, because it reads the kernel's system clock. Gated on the OS rather than
# on //target:defs.bzl, as //util/ipc is, so shared code does not load from
# //target.
rust_library(
    name = "millis_epoch",
    srcs = ["src/lib.rs"],
    crate_name = "util_millis_epoch",
    edition = "2024",
    tags = ["kernel"],
    target_compatible_with = select({
        "@platforms//os:none": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//visibility:public"],
    deps = [
        "@pigweed//pw_kernel/userspace",
    ],
)
