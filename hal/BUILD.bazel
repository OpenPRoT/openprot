load("@rules_rust//rust:defs.bzl", "rust_doc", "rust_library")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "hal",
    srcs = glob([
        "src/*.rs",
        "src/**/*.rs",
    ]),
    crate_name = "openprot_hal",
    edition = "2024",
)

rust_doc(
    name = "openprot_hal_doc",
    crate = ":hal",
)
