rust_binary(
    name = "mcu_rom_fpga",
    srcs = ["@caliptra_mcu_sw//:all_files"],
    compile_data = [":fpga-rom-layout.ld"],
    crate_root = "@caliptra_mcu_sw//:platforms/fpga/rom/src/main.rs",
    edition = "2021",
    rustc_flags = _MCU_ROM_RUSTC_FLAGS + [
        "-C",
        "link-arg=-T$(location :fpga-rom-layout.ld)",
    ],
    tags = ["manual"],
    deps = [
        ":mcu_rom_common",
        ":romtime",
        "//third_party/caliptra:crate_caliptra-mcu-registers-generated",
        "//third_party/caliptra:crate_tock-registers",
        "@rust_caliptra_crates//:caliptra-mcu-config",
        "@rust_caliptra_crates//:caliptra-mcu-config-fpga",
        "@rust_caliptra_crates//:riscv-csr",
        "@rust_caliptra_crates//:rv32i",
    ],
)

# Selects the MCU ROM for //third_party/caliptra:platform.
alias(
    name = "mcu_rom_for_platform",
    actual = select({
        "//third_party/caliptra:platform_fpga": ":mcu_rom_fpga",
        "//conditions:default": ":mcu_rom",
    }),
    tags = ["manual"],
)

caliptra_objcopy(
    name = "mcu_rom_bin",
    src = ":mcu_rom_for_platform",
    out = "mcu_rom.bin",
    # Must match `FPGA_MEMORY_MAP.rom_size` / `EMULATOR_MEMORY_MAP.rom_size`.
    rom_size = select({
        "//third_party/caliptra:platform_fpga": "131072",
        "//conditions:default": "65536",
    }),
    tags = [
        "manual",
        "no-sandbox",
    ],
)
