    name = "generate_rom_ld",
    srcs = ["src/generate_rom_ld.rs"],
    edition = "2021",
    deps = [
        "@rust_caliptra_crates_host//:caliptra-mcu-config-emulator",
        "@rust_caliptra_crates_host//:caliptra-mcu-config-fpga",
        "@rust_caliptra_crates_host//:subst",
    ],
)

caliptra_linker_script(
    name = "emulator_rom_layout",
    out = "emulator-rom-layout.ld",
    args = ["emulator"],
    generator = ":generate_rom_ld",
)

caliptra_linker_script(
    name = "fpga_rom_layout",
    out = "fpga-rom-layout.ld",
    args = ["fpga"],
    generator = ":generate_rom_ld",
)

_MCU_ROM_RUSTC_FLAGS = [
    "-A",
    "dead_code",
    "--cap-lints=allow",
    "--cfg",
    'target_arch="riscv32"',
    "-C",
    "panic=abort",
    "-C",
    "opt-level=z",
    "-C",
    "codegen-units=1",
    "-C",
    "lto=fat",
    "-C",
    "embed-bitcode=yes",
    "-C",
    "target-feature=+relax,+zba,+zbb,+zbc,+zbs",
    "-C",
    "force-frame-pointers=no",
    "-C",
    "relocation-model=static",
    "-C",
    "symbol-mangling-version=v0",
    "-C",
    "link-arg=-Wl,-nmagic",
    "-C",
    "link-arg=-Wl,--icf=all",
]

# NOTE: This target requires the caliptra RISC-V platform transition to build.
