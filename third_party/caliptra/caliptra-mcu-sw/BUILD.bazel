# Shared size-optimization / LTO / RISC-V target-feature flags for MCU ROM
# libraries so fat LTO across the rlib/binary boundary applies across all
# embedded dependencies of mcu_rom.
_MCU_ROM_LIB_RUSTC_FLAGS = [
    "--cap-lints=allow",
    "-C",
    "opt-level=z",
    "-C",
    "codegen-units=1",
    "-C",
    "embed-bitcode=yes",
] + select({
    "//third_party/caliptra:is_riscv32imc": [
        "-C",
        "target-feature=+relax,+zba,+zbb,+zbc,+zbs",
    ],
    "//conditions:default": [],
})

