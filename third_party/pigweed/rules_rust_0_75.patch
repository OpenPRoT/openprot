 use std::env;
 use std::fs::File;
-use std::io::Write;
+use std::io::{BufRead, BufReader, Write};
+
+fn expand_arg(arg: &str, output: &mut Vec<String>) {
+    if let Some(param_path) = arg.strip_prefix('@') {
+        if let Ok(file) = File::open(param_path) {
+            let reader = BufReader::new(file);
+            for line in reader.lines() {
+                let line =
+                    line.unwrap_or_else(|_| panic!("Failed to read line from {}", param_path));
+                expand_arg(&line, output);
+            }
+            return;
+        }
+    }
+    output.push(arg.to_string());
+}
 
 // Simple utility to capture command line arguments and write them to a file.
 pub fn main() {
@@ -25,7 +40,10 @@ pub fn main() {
 
