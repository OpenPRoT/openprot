From 73fca35b0436cee7dd156d1e0450adb82fa635c8 Mon Sep 17 00:00:00 2001
From: Anthony Rocha <anthony.rocha@amd.com>
Date: Sat, 15 Aug 2026 14:44:54 -0700
Subject: [PATCH 1/3] pw_kernel: Add type-check-only VeerPicConfig for
 qemu_virt_riscv32

veer_pic.rs needs a VeerPicConfigInterface impl to compile, and no upstream
target has a VeeR PIC. The addresses are placeholders: qemu virt is a PLIC
machine, so this config never executes. Also fix the one clippy failure that
building veer_pic.rs uncovers.

Change-Id: Ice1af6a829df590a0a2a0d107cbb39c00a33d486
---
 pw_kernel/arch/riscv/veer_pic.rs             |  2 +-
 pw_kernel/target/qemu_virt_riscv32/config.rs | 11 ++++++++++-
 2 files changed, 11 insertions(+), 2 deletions(-)

diff --git a/pw_kernel/arch/riscv/veer_pic.rs b/pw_kernel/arch/riscv/veer_pic.rs
index e5b6f6333..cce342e98 100644
--- a/pw_kernel/arch/riscv/veer_pic.rs
+++ b/pw_kernel/arch/riscv/veer_pic.rs
@@ -215,7 +215,7 @@ pub fn interrupt(from_userspace: bool) {
     // need to write to MEICPCT to capture the interrupt value into meihap.
     MeiCPCT::write(MeiCPCTVal::default());
     let meihap = MeiHAP::read();
-    let irq = meihap.claimid() as u32;
+    let irq = u32::from(meihap.claimid());
 
     if irq == 0 {
         return;
diff --git a/pw_kernel/target/qemu_virt_riscv32/config.rs b/pw_kernel/target/qemu_virt_riscv32/config.rs
index 26f5f458e..af5685ab8 100644
--- a/pw_kernel/target/qemu_virt_riscv32/config.rs
+++ b/pw_kernel/target/qemu_virt_riscv32/config.rs
@@ -17,7 +17,7 @@ use core::ops::Range;
 
 pub use kernel_config::{
     ClintTimerConfigInterface, ExceptionMode, KernelConfigInterface, PlicConfigInterface,
-    RiscVKernelConfigInterface,
+    RiscVKernelConfigInterface, VeerPicConfigInterface,
 };
 use memory_config::{MemoryRegion, MemoryRegionType};
 
@@ -54,6 +54,15 @@ impl PlicConfigInterface for PlicConfig {
     const PLIC_BASE_ADDRESS: usize = 0x0c00_0000;
 }
 
+// qemu virt has no VeeR PIC. This exists so `veer_pic.rs` type-checks under
+// --//pw_kernel/arch/riscv:veer_pic=true; that build is not runnable here, as the
+// PIC MMIO window is unmapped and VeeR's PIC CSRs trap as illegal instructions.
+pub struct VeerPicConfig;
+
+impl VeerPicConfigInterface for VeerPicConfig {
+    const PIC_BASE_ADDRESS: usize = 0x0f00_0000;
+}
+
 pub struct TimerConfig;
 
 const TIMER_BASE: usize = 0x200_0000;
-- 
