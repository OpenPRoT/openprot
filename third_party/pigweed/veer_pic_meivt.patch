From 89b731a7ed30daa46dd0c0e7f9d311caca1569ca Mon Sep 17 00:00:00 2001
From: Anthony Rocha <anthony.rocha@amd.com>
Date: Sat, 15 Aug 2026 14:55:39 -0700
Subject: [PATCH 2/3] pw_kernel: Program the VeeR MEIVT redirect table

VeeR loads the word at MEIVT + 4 * claimid and jumps to it; mtvec is not
consulted. Point every entry at the trap vector so external interrupts take
the standard trap path. The base is a required const so a target cannot
enable mext without a table.

Change-Id: I620a7b97d41df2c3d50632fc4870c4a98797c0f8
---
 pw_kernel/arch/riscv/veer_pic.rs             | 32 +++++++++++++++++++-
 pw_kernel/config/lib.rs                      | 12 ++++++++
 pw_kernel/target/qemu_virt_riscv32/config.rs |  2 ++
 3 files changed, 45 insertions(+), 1 deletion(-)

diff --git a/pw_kernel/arch/riscv/veer_pic.rs b/pw_kernel/arch/riscv/veer_pic.rs
index cce342e98..81514b3fc 100644
--- a/pw_kernel/arch/riscv/veer_pic.rs
+++ b/pw_kernel/arch/riscv/veer_pic.rs
@@ -21,7 +21,8 @@ use log_if::debug_if;
 use pw_log::info;
 use regs::{rw_block_reg, rw_bool_field, rw_int_field};
 
-use crate::regs::veer::{MeiCPCT, MeiCPCTVal, MeiHAP, MeiPT, MeiPTVal};
+use crate::regs::MtVec;
+use crate::regs::veer::{MeiCPCT, MeiCPCTVal, MeiHAP, MeiPT, MeiPTVal, MeiVT, MeiVTVal};
 
 const LOG_INTERRUPTS: bool = false;
 
@@ -280,6 +281,35 @@ impl InterruptController for VeerPic {
         );
         set_global_priority(GLOBAL_PRIORITY);
 
+        // VeeR delivers an external interrupt by loading the word at
+        // `MEIVT + 4 * claimid` and jumping to it; mtvec is not consulted.
+        // Point every entry at the trap vector so redirected interrupts take
+        // the standard trap path, where `interrupt()` recovers the claim id
+        // from MEIHAP. Kept unconditional and directly above `set_mext()`:
+        // arming external interrupts against an unprogrammed table jumps to
+        // whatever the table memory happened to contain.
+        let base = VeerPicConfig::MEIVT_BASE_ADDRESS;
+        // MEIVT supplies MEIHAP[31:10], so the table must be 1KiB-aligned, and
+        // claimid is 8 bits, so the core can only reach 256 entries. It must
+        // also lie within DCCM or the core takes an NMI instead of the
+        // interrupt.
+        pw_assert::assert!(base & 0x3ff == 0);
+        pw_assert::assert!(VeerPicConfig::MAX_IRQS <= 256);
+        // Requires mtvec to already be programmed. It is: the reset vector sets
+        // it before `main`, ahead of the kernel's own `exceptions::early_init`.
+        let Ok(trap_vector) = u32::try_from(MtVec::read().base()) else {
+            pw_assert::panic!("mtvec base does not fit in a redirect table entry");
+        };
+        pw_assert::assert!(trap_vector != 0);
+        for irq in 0..VeerPicConfig::MAX_IRQS as usize {
+            // SAFETY: the target guarantees the region at `base` is reserved
+            // for the redirect table.
+            unsafe {
+                ptr::write_volatile((base + irq * size_of::<u32>()) as *mut u32, trap_vector);
+            }
+        }
+        MeiVT::write(MeiVTVal(base));
+
         unsafe {
             riscv::register::mie::set_mext();
         }
diff --git a/pw_kernel/config/lib.rs b/pw_kernel/config/lib.rs
index 60446ff12..38d0a0291 100644
--- a/pw_kernel/config/lib.rs
+++ b/pw_kernel/config/lib.rs
@@ -100,6 +100,18 @@ pub trait VeerPicConfigInterface {
     /// The maximum number of interrupts the
     /// PIC supports per context.
     const MAX_IRQS: u32 = 256;
+
+    /// Base address of the external-interrupt redirect table, written to MEIVT.
+    ///
+    /// Required: the core loads the word at `MEIVT + 4 * claimid` and jumps to
+    /// it on every external interrupt, so a target that enables machine
+    /// external interrupts must supply a table. Building without the
+    /// `veer_pic` flag is how a target opts out of that interrupt source.
+    ///
+    /// Must be 1KiB-aligned; MEIVT supplies bits [31:10] of MEIHAP. Some
+    /// integrations constrain the address further (the Caliptra MCU requires
+    /// it to fall within DCCM).
+    const MEIVT_BASE_ADDRESS: usize;
 }
 
 /// CLINT timer config.
diff --git a/pw_kernel/target/qemu_virt_riscv32/config.rs b/pw_kernel/target/qemu_virt_riscv32/config.rs
index af5685ab8..22fa57641 100644
--- a/pw_kernel/target/qemu_virt_riscv32/config.rs
+++ b/pw_kernel/target/qemu_virt_riscv32/config.rs
@@ -61,6 +61,8 @@ pub struct VeerPicConfig;
 
 impl VeerPicConfigInterface for VeerPicConfig {
     const PIC_BASE_ADDRESS: usize = 0x0f00_0000;
+    // Placeholder, like PIC_BASE_ADDRESS above: nothing here executes.
+    const MEIVT_BASE_ADDRESS: usize = 0x0f01_0000;
 }
 
 pub struct TimerConfig;
-- 
2.34.1


From 0b3580d7540172709725133e172c2a74fe7cbd41 Mon Sep 17 00:00:00 2001
From: Anthony Rocha <anthony.rocha@amd.com>
Date: Sat, 15 Aug 2026 15:06:44 -0700
Subject: [PATCH 3/3] pw_kernel: Test MEIHAP field decoding

Change-Id: I552be247954aacf0a351b54b5458152a519ca1ad
---
 pw_kernel/arch/riscv/regs/veer.rs | 28 ++++++++++++++++++++++++++++
 1 file changed, 28 insertions(+)

diff --git a/pw_kernel/arch/riscv/regs/veer.rs b/pw_kernel/arch/riscv/regs/veer.rs
index 42f02ede3..d05cf8e46 100644
--- a/pw_kernel/arch/riscv/regs/veer.rs
+++ b/pw_kernel/arch/riscv/regs/veer.rs
@@ -181,3 +181,31 @@ rw_csr_reg!(
     0xfc8,
     "Machine External Interrupt Handler Address Pointer"
 );
+
+#[cfg(test)]
+mod tests {
+    use unittest::test;
+
+    use super::MeiHAPVal;
+
+    /// Hardware composes MEIHAP as `{MEIVT[31:10], CLAIMID[7:0], 2'b0}`. The PIC
+    /// driver dispatches on `claimid`, so an off-by-one in the field range routes
+    /// every interrupt to the wrong handler without any other symptom.
+    #[test]
+    fn meihap_splits_base_and_claimid() -> unittest::Result<()> {
+        const TABLE_BASE: usize = 0xf004_0000;
+        let meihap = MeiHAPVal(TABLE_BASE | (37 << 2));
+
+        unittest::assert_eq!(meihap.claimid(), 37);
+        unittest::assert_eq!(meihap.base(), TABLE_BASE >> 10);
+
+        // Bits [1:0] are always zero in hardware and are not part of claimid.
+        unittest::assert_eq!(MeiHAPVal(0b11).claimid(), 0);
+
+        // claimid is 8 bits wide and must not bleed into the table base.
+        let max_claim = MeiHAPVal(0).with_claimid(0xff);
+        unittest::assert_eq!(max_claim.claimid(), 0xff);
+        unittest::assert_eq!(max_claim.base(), 0);
+        Ok(())
+    }
+}
-- 
2.34.1

