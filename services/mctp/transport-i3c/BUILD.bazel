load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Host-buildable: the sender is generic over i3c_api::Transport, so the whole
# binding is exercised on the host against i3c_server's LoopbackTransport.
rust_library(
    name = "mctp_transport_i3c",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "openprot_mctp_transport_i3c",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "//services/i3c/api:i3c_api",
        "//services/i3c/client:i3c_client",
        "//services/mctp/api:mctp_api",
        "@pigweed//pw_log/rust:pw_log",
        "@rust_crates//:mctp",
        "@rust_crates//:mctp-lib",
    ],
)

# Encapsulation unit tests (in-crate).
rust_test(
    name = "mctp_transport_i3c_test",
    crate = ":mctp_transport_i3c",
    deps = [
        "//services/i3c/api:i3c_api",
        "//services/i3c/client:i3c_client",
        "//services/mctp/api:mctp_api",
        "@rust_crates//:mctp",
        "@rust_crates//:mctp-lib",
    ],
)

# End-to-end: MCTP Server -> I3cSender -> i3c dispatch -> mock target, and back
# out through MctpI3cReceiver. No kernel, no emulator.
rust_test(
    name = "mctp_transport_i3c_roundtrip_test",
    srcs = ["tests/roundtrip.rs"],
    edition = "2024",
    deps = [
        ":mctp_transport_i3c",
        "//hal/blocking",
        "//services/i3c/api:i3c_api",
        "//services/i3c/client:i3c_client",
        "//services/i3c/server:i3c_server",
        "//services/mctp/api:mctp_api",
        "//services/mctp/server:mctp_server_lib",
        "@rust_crates//:mctp",
        "@rust_crates//:mctp-lib",
    ],
)
